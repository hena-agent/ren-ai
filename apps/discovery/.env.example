PORT=3867
DISCOVERY_API_URL=http://127.0.0.1:4879
# Profile reads and registration use api-app; Vite proxies /discovery/ locally.
# The production Worker uses wrangler.jsonc's DISCOVERY_API_URL variable.
# For local SSR, override it with wrangler dev --var DISCOVERY_API_URL:http://127.0.0.1:4879.
# VITE_DISCOVERY_API_URL=https://api.renai.im
