{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "persona-discovery",
  "account_id": "b1e7a34d896345430d5982b9baecd07c",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "main": "worker/entry.ts",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DISCOVERY_API_URL": "https://api.renai.im" },
  "images": { "binding": "IMAGE_TRANSFORMS" },
  "r2_buckets": [{ "binding": "PORTRAITS", "bucket_name": "persona-images" }],
  "route": { "pattern": "renai.im", "custom_domain": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/explore",
      "/explore/",
      "/ko",
      "/ko/*",
      "/en",
      "/en/*",
      "/ja",
      "/ja/*",
      "/personas",
      "/personas/*",
      "/sitemap.xml",
      "/robots.txt",
      "/health",
    ],
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": true },
}
