{
  "name": "@ren-ai/api-msg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gateway": "./src/gateway.ts",
    "./health": "./src/health.ts"
  },
  "scripts": {
    "dev": "PORT=${API_MSG_PORT:-4700} bun --watch ops/api-msg-entry.mjs",
    "start": "bun run ops/api-msg-entry.mjs",
    "probe": "bun run ops/probe-entry.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ren-ai/imsg": "workspace:*",
    "@ren-ai/transport": "workspace:*",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
