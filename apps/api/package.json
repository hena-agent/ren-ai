{
  "name": "@ren-ai/api-app",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "ren-ai-api-worker-build": "./scripts/build-worker.mjs",
    "ren-ai-operator": "./src/operator-entry.ts"
  },
  "type": "module",
  "main": "./worker/entry.ts",
  "exports": "./worker/entry.ts",
  "scripts": {
    "state:export": "node ops/export-application-state.ts",
    "state:import": "bun ops/import-application-state.ts",
    "build:worker": "bun scripts/build-worker.mjs",
    "start": "bun run dev",
    "dev": "wrangler dev --config wrangler.jsonc --env-file .env.development --port ${API_APP_PORT:-4879} --inspector-port ${API_APP_INSPECTOR_PORT:-5879}",
    "opencode:config": "bun run ops/location-config.ts",
    "opencode:proxy": "bun run ops/patch-opencode-proxy.ts",
    "migration:export-legacy": "bun run ops/offline-export.ts",
    "migration:sessions": "bun run ops/session-transfer.ts",
    "operator": "bun run src/operator-entry.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@opencode/client": "2.0.19",
    "@opencode/schema": "2.0.19",
    "@ren-ai/imsg": "workspace:*",
    "@ren-ai/onboarding": "workspace:*",
    "@ren-ai/personas": "workspace:*",
    "@ren-ai/plugin-application": "workspace:*",
    "@ren-ai/plugin-session-folder": "workspace:*",
    "@ren-ai/transport": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@opencode/ai": "2.0.19",
    "@opencode/core": "2.0.19",
    "@opencode/plugin": "2.0.19",
    "@opencode/server": "2.0.19",
    "@ren-ai/plugin-context": "workspace:*",
    "@ren-ai/plugin-dice": "workspace:*",
    "@ren-ai/plugin-memory": "workspace:*",
    "@ren-ai/plugin-title": "workspace:*",
    "@ren-ai/plugin-tools": "workspace:*",
    "@total-typescript/shoehorn": "0.1.2",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.149.0"
  }
}
