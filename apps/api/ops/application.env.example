# Private Mac api-msg executor environment. Copy outside Git and replace placeholders.
TOKEN_EXECUTOR=REPLACE_WITH_EXECUTOR_SHARED_TOKEN
IMSG_URL=https://imsg.renai.im/rpc
IMSG_TOKEN=REPLACE_WITH_EXISTING_MESSAGING_SERVICE_TOKEN
# Apply/review the native-Basic proxy adapter and verify public HTTPS machine
# authentication BEFORE starting the application (including bootstrap/import).
OPENCODE_URL=https://oc.renai.im
OPENCODE_AUTHORIZATION="Basic REPLACE_WITH_NATIVE_OPENCODE_BASIC_HEADER"
OPENCODE_DIRECTORY=/srv/ren-ai
