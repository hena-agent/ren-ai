API_APP_PORT=4879
API_APP_INSPECTOR_PORT=5879
# The operator/transfer commands use the local Worker by default.
API_APP_URL=http://127.0.0.1:4879
PERSONA_CATALOG_URL=http://127.0.0.1:3729
# Must match admin.
TOKEN_CATALOG=local-catalog
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Must match admin and api-msg. Replace these local-only tokens together.
TOKEN_MANAGEMENT=local-management
API_MSG_URL=http://127.0.0.1:4700
PERSONA_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_DIRECTORY=/srv/ren-ai
BOOTSTRAP_ONLY=true
# Private Codex image provider credential; R2 is bound by wrangler.jsonc.
CODEX_IMAGE_API_KEY=
# Separate Discord channels. Missing URLs are visible as degraded health.
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_REPORT_WEBHOOK_URL=
SOCIAL_EXECUTOR_URL=http://127.0.0.1:5407
