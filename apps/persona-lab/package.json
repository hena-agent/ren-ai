{
  "name": "@ren-ai/persona-lab",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "persona-lab": "./src/run.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run --parallel --no-orphans dev:api dev:web",
    "dev:api": "PORT=${BACKEND_PORT:-4617} bun --watch src/run.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "start": "bun run build && bun src/run.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@ren-ai/persona-engine": "workspace:*",
    "@ren-ai/transport": "workspace:*",
    "ai": "7.0.155",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
