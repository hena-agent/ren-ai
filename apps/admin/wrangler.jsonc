{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "persona-admin",
  "main": "dist/worker/entry.js",
  "build": { "command": "bun run build" },
  "no_bundle": true,
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 3729 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "persona-catalog",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "persona-images" }],
  "durable_objects": { "bindings": [{ "name": "ADMIN", "class_name": "PersonaAdmin" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonaAdmin"] }],
  "observability": { "enabled": true },
}
