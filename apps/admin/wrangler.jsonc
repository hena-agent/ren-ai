{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "persona-admin",
  "account_id": "b1e7a34d896345430d5982b9baecd07c",
  "workers_dev": false,
  "route": { "pattern": "admin.ambivalent.dev", "custom_domain": true },
  "vars": { "MESSAGING_API_URL": "https://api-msg.hena.dev", "ADMIN_JURISDICTION": "us" },
  "placement": { "mode": "smart" },
  "main": "dist/worker/entry.js",
  "build": { "command": "bun run build" },
  "no_bundle": true,
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 3729 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "persona-catalog",
      "database_id": "da5c6ee3-7ea6-49b3-8e6f-6ceff12d3f7f",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "persona-images" }],
  "durable_objects": { "bindings": [{ "name": "ADMIN", "class_name": "PersonaAdmin" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonaAdmin"] }],
  "observability": { "enabled": true },
}
