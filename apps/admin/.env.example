PORT=3729
ADMIN_INSPECTOR_PORT=5729
# Local Worker bindings/secrets. Production secrets are managed by Wrangler.
ADMIN_PASSWORD=replace-with-a-local-password
TOKEN_CATALOG=local-catalog
GEMINI_API_KEY=replace-with-a-gemini-key
ADMIN_TEXT_MODEL=gemini-3.8-flash
# Switch only images; text generation continues using Gemini.
ADMIN_IMAGE_PROVIDER=gemini
# Optional model override; omit to use each provider's canonical default.
# ADMIN_IMAGE_MODEL=gemini-3.1-flash-image
# For ADMIN_IMAGE_PROVIDER=codex (codex-image.renai.im, gpt-image-2.5):
# CODEX_IMAGE_API_KEY=replace-with-a-codex-image-key
# rig-c 원화: models.dev 공통 카탈로그 + 공급자별 이미지 API.
# 연결할 공급자의 키만 설정하세요. 키는 브라우저에 전달하지 않습니다.
# Google 원화 모델은 위 GEMINI_API_KEY를 재사용합니다.
# FAL_KEY=replace-with-a-fal-key
# OPENAI_API_KEY=replace-with-an-openai-key
# OPENROUTER_API_KEY=replace-with-an-openrouter-key
APPLICATION_API_URL=http://127.0.0.1:4879
# Must match api and api-msg.
TOKEN_MANAGEMENT=local-management
