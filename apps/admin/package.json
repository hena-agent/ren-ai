{
  "name": "@ren-ai/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./worker/entry.mjs",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "dev": "wrangler dev --local-upstream localhost:${PORT:-3729} --port ${PORT:-3729} --inspector-port ${ADMIN_INSPECTOR_PORT:-5729} --var ADMIN_JURISDICTION:local",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "import:local": "bun scripts/import-local.mjs",
    "thumbnails": "node --experimental-transform-types scripts/thumbnails.mjs",
    "projections": "node --experimental-transform-types scripts/projections.mjs",
    "seed:korea": "bun scripts/seed.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@ren-ai/image-generation": "workspace:*",
    "@ren-ai/onboarding": "workspace:*",
    "@ren-ai/personas": "workspace:*",
    "@ren-ai/transport": "workspace:*",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.7",
    "image-size": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@total-typescript/shoehorn": "0.1.2",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "miniflare": "5.20261023.1-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
