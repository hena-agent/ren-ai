{
  "name": "@ren-ai/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./worker/entry.mjs",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "dev": "wrangler dev --port ${PORT:-3729} --var ADMIN_JURISDICTION:local",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "import:local": "bun scripts/import-local.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@ren-ai/onboarding": "workspace:*",
    "@ren-ai/personas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.0-rc.112",
    "image-size": "2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@total-typescript/shoehorn": "0.1.2",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.149.0"
  }
}
