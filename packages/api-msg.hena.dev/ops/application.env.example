# Copy into an owner-only file outside Git; replace every placeholder.
IMSG_URL=https://imsg.hena.dev/rpc
IMSG_TOKEN=REPLACE_WITH_MESSAGING_SERVICE_TOKEN
# Apply/review the native-Basic proxy adapter and verify public HTTPS machine
# authentication BEFORE starting the application (including bootstrap/import).
OPENCODE_URL=https://oc.hena.dev
OPENCODE_AUTHORIZATION="Basic REPLACE_WITH_NATIVE_OPENCODE_BASIC_HEADER"
OPENCODE_DIRECTORY=/srv/ren-ai
PERSONA_MODEL=opencode-go/deepseek-v4.1-flash
TURNSTILE_SECRET=REPLACE_WITH_EXISTING_TURNSTILE_SECRET
REN_AI_APPLICATION_TOKEN=REPLACE_WITH_APPLICATION_PLUGIN_TOKEN
DISCORD_WEBHOOK_URL=REPLACE_WITH_EXISTING_DISCORD_WEBHOOK
# Initial import must run with callback HTTP available, no AI intake/recovery.
BOOTSTRAP_ONLY=true
