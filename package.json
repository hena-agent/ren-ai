{
  "name": "ren-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "ci": "bun run ci:checks && bun run verify-gates && bun run ci:native",
    "ci:native": "bash apps/rustpush/check.sh",
    "ci:checks": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run dup && bun run exceptions && bun run --cwd apps/discovery build && bun run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun run scripts/run-quality-gate.ts lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:changed": "vitest run --changed origin/main --coverage",
    "knip": "knip && knip --production --config knip.production.json",
    "dup": "bun run scripts/run-quality-gate.ts duplication",
    "exceptions": "bun run scripts/exceptions.ts",
    "verify-gates": "bun run scripts/verify-gates.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-complexity": "4.0.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.7",
    "effect": "4.0.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  },
  "patchedDependencies": {
    "knip@6.43.0": "patches/knip@6.43.0.patch"
  }
}
