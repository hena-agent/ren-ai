{
  "name": "ren-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "ci": "bun run ci:checks && bun run verify-gates",
    "ci:checks": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run knip && bun run dup && bun run exceptions && bun run --cwd packages/discovery.hena.dev build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun run scripts/run-quality-gate.ts lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "knip": "knip && knip --production --config knip.production.json",
    "dup": "bun run scripts/run-quality-gate.ts duplication",
    "exceptions": "bun run scripts/exceptions.ts",
    "verify-gates": "bun run scripts/verify-gates.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-complexity": "3.0.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.4",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  }
}
