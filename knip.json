{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/*.ts"] },
    "apps/admin": {
      "entry": [
        "worker/entry.mjs",
        "src/pending-entry.mjs",
        "scripts/build.mjs",
        "scripts/import-local.mjs",
        "scripts/seed.mjs",
        "worker/test-seeding.ts"
      ]
    },
    "apps/api": {
      "entry": ["src/server-entry.ts", "test/compiled-plugin/regression.mjs"]
    },
    "apps/api-msg": {
      "entry": ["ops/probe-entry.mjs"]
    }
  },
  "ignore": [".agents/**", "scripts/**/*.mjs"],
  "ignoreDependencies": ["jscpd", "cloudflare"]
}
