{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/exceptions.ts!",
        "scripts/run-quality-gate.ts!",
        "scripts/verify-gates.ts!"
      ]
    },
    "apps/api": {
      "entry": [
        "worker/entry.ts!",
        "src/server-entry.ts!",
        "src/operator-entry.ts!",
        "ops/check-health.ts!",
        "ops/location-config.ts!",
        "ops/offline-export.ts!",
        "ops/patch-opencode-proxy.ts!",
        "ops/session-transfer.ts!",
        "ops/export-application-state.ts!",
        "ops/import-application-state.ts!",
        "test/compiled-plugin/regression.mjs!"
      ]
    },
    "apps/imsg": {
      "entry": [
        "ops/imsg-entry.ts!",
        "ops/imsg-verify.ts!",
        "ops/mdm/enrollment-entry.ts!",
        "ops/mdm/profile-entry.ts!",
        "ops/verify-mac-graph.ts!"
      ]
    },
    "apps/api-msg": {
      "entry": ["ops/api-msg-entry.mjs!", "ops/probe-entry.mjs!"]
    },
    "apps/admin": {
      "entry": [
        "worker/entry.mjs!",
        "src/pending-entry.mjs!",
        "scripts/build.mjs!",
        "scripts/import-local.mjs!",
        "scripts/seed.mjs!",
        "scripts/thumbnails.mjs!",
        "scripts/projections.mjs!",
        "worker/test-seeding.ts!"
      ]
    },
    "apps/discovery": {
      "entry": [
        "index.html",
        "src/prerender.ts!",
        "worker/entry.ts!",
        "ops/check-preview.ts!",
        "ops/check-worker.ts!"
      ]
    }
  },
  "ignore": [".agents/**", "scripts/**/*.mjs"],
  "ignoreFiles": ["**/*.fake.ts", "**/*.test-helper.ts", "apps/*/test/**"],
  "ignoreDependencies": ["jscpd", "cloudflare"]
}
