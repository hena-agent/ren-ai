{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/exceptions.ts!",
        "scripts/run-quality-gate.ts!",
        "scripts/verify-gates.ts!"
      ]
    },
    "apps/api": {
      "entry": [
        "src/server-entry.ts!",
        "src/operator-entry.ts!",
        "ops/location-config.ts!",
        "ops/offline-export.ts!",
        "ops/patch-opencode-proxy.ts!",
        "ops/session-transfer.ts!",
        "test/compiled-plugin/regression.mjs!"
      ]
    },
    "apps/imsg": {
      "entry": [
        "ops/imsg-entry.ts!",
        "ops/imsg-verify.ts!",
        "ops/mdm/enrollment-entry.ts!",
        "ops/mdm/profile-entry.ts!",
        "ops/verify-mac-graph.ts!"
      ]
    },
    "apps/admin": {
      "entry": [
        "worker/entry.mjs!",
        "src/pending-entry.mjs!",
        "scripts/build.mjs!",
        "scripts/import-local.mjs!"
      ]
    },
    "apps/discovery": {
      "entry": ["index.html", "worker/entry.mjs!", "scripts/build-worker.mjs!"]
    }
  },
  "ignore": [".agents/**", "scripts/**/*.mjs"],
  "ignoreFiles": ["**/*.fake.ts", "**/*.test-helper.ts", "apps/*/test/**"],
  "ignoreDependencies": ["jscpd", "cloudflare"]
}
