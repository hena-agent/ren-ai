{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "PORT",
        "ADMIN_INSPECTOR_PORT",
        "API_APP_*",
        "API_MSG_*",
        "DISCOVERY_*",
        "TOKEN_MANAGEMENT",
        "OPENCODE_*",
        "IMSG_*"
      ]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "web/**",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    }
  }
}
